
import streamlit as st
import requests

# -----------------------------------------
# 1. Set up the page
# -----------------------------------------

st.set_page_config(
    page_title="Currency Converter",
    page_icon="💱",
    layout="centered"
)

# -----------------------------------------
# 2. Display the app title and description
# -----------------------------------------

st.title("💱 Dollar to Euro Converter")

st.write(
    "Convert US Dollars and Euros quickly "
    "using the latest available exchange rate."
)

st.divider()

# -----------------------------------------
# 3. Create the currency input
# -----------------------------------------

amount = st.number_input(
    "Enter the amount:",
    min_value=0.0,
    value=100.0,
    step=1.0,
    format="%.2f"
)

# -----------------------------------------
# 4. Let the user select conversion direction
# -----------------------------------------

conversion_type = st.selectbox(
    "Choose conversion direction:",
    [
        "US Dollars (USD) to Euros (EUR)",
        "Euros (EUR) to US Dollars (USD)"
    ]
)

# -----------------------------------------
# 5. Get the exchange rate from the API
# -----------------------------------------

@st.cache_data(ttl=3600)
def get_exchange_rate(from_currency, to_currency):

    # Request the latest available reference exchange rate
    url = (
        f"https://api.frankfurter.dev/v2/"
        f"rate/{from_currency}/{to_currency}"
    )

    response = requests.get(url, timeout=10)

    # Check whether the request was successful
    response.raise_for_status()

    # Convert the response into Python data
    data = response.json()

    return data["rate"], data["date"]


# -----------------------------------------
# 6. Convert the currency when button is clicked
# -----------------------------------------

if st.button("Convert Currency", type="primary"):

    try:

        # Determine which currencies are being converted
        if conversion_type == "US Dollars (USD) to Euros (EUR)":

            from_currency = "USD"
            to_currency = "EUR"

            from_symbol = "$"
            to_symbol = "€"

        else:

            from_currency = "EUR"
            to_currency = "USD"

            from_symbol = "€"
            to_symbol = "$"

        # Get the exchange rate
        exchange_rate, rate_date = get_exchange_rate(
            from_currency,
            to_currency
        )

        # Calculate the converted amount
        converted_amount = amount * exchange_rate

        # -----------------------------------------
        # 7. Display the conversion result
        # -----------------------------------------

        st.success("Currency Conversion Successful!")

        st.metric(
            label="Converted Amount",
            value=f"{to_symbol}{converted_amount:,.2f}"
        )

        st.write(
            f"{from_symbol}{amount:,.2f} "
            f"= {to_symbol}{converted_amount:,.2f}"
        )

        # -----------------------------------------
        # 8. Display the exchange rate and formula
        # -----------------------------------------

        st.subheader("Exchange Rate Information")

        st.write(
            f"1 {from_currency} = "
            f"{exchange_rate:.5f} {to_currency}"
        )

        st.caption(f"Rate date: {rate_date}")

        st.subheader("Conversion Formula")

        st.latex(
            r"\text{Converted Amount} = "
            r"\text{Original Amount} \times "
            r"\text{Exchange Rate}"
        )

        st.write(
            f"{to_symbol}{converted_amount:,.2f} = "
            f"{from_symbol}{amount:,.2f} × "
            f"{exchange_rate:.5f}"
        )

    except requests.exceptions.RequestException:

        st.error(
            "Unable to retrieve the exchange rate. "
            "Please check your internet connection and try again."
        )

    except (KeyError, ValueError):

        st.error(
            "There was a problem reading the exchange rate. "
            "Please try again later."
        )

# -----------------------------------------
# 9. Add a footer
# -----------------------------------------

st.divider()

st.caption(
    "Currency Converter | Exchange rates provided by Frankfurter. "
    "Rates are reference rates and may differ from bank or card rates."
)
